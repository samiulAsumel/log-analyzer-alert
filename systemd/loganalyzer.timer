[Unit]
Description=Log Analyzer — run every 15 minutes
Documentation=https://github.com/samiulAsumel/log-analyzer-alert
Requires=loganalyzer.service

[Timer]
# Run 1 minute after boot, then every 15 minutes
OnBootSec=1min
OnUnitActiveSec=15min
Unit=loganalyzer.service
# Persist the timer so a missed run fires on next boot
Persistent=true
# Randomized delay (0–60s) to avoid thundering-herd on multi-server deployments
RandomizedDelaySec=60

[Install]
WantedBy=timers.target
